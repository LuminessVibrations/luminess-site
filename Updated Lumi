const views={home:document.getElementById('v-home'),attunement:document.getElementById('v-attunement'),creations:document.getElementById('v-creations'),shop:document.getElementById('v-shop')};
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{threshold:.12});
function route(){
