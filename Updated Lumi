setInterval(()=>{i=(i+1)%T.length;b.style.opacity=c.style.opacity=0;setTimeout(()=>{b.textContent=T[i][1];c.textContent=T[i][0];b.style.opacity=c.style.opacity=1},400)},9000)})();

// lightbox
const lb=document.createElement('div');lb.className='lb';lb.setAttribute('role','dialog');lb.innerHTML='<button class="lbx" aria-label="Close">✕</button><button class="lbp" aria-label="Previous">‹</button><figure><img alt=""><figcaption></figcaption></figure><button class="lbn" aria-label="Next">›</button>';document.body.appendChild(lb);
let zs=[],zi=0;
function zshow(){const m=zs[zi],i=lb.querySelector('img');i.src=m.src;i.alt=m.alt;lb.querySelector('figcaption').textContent=m.dataset.name||''}
function zopen(m){zs=[...document.querySelectorAll('.view.on img[data-zoom]')];zi=zs.indexOf(m);zshow();lb.classList.add('on')}
function zmove(d){zi=(zi+d+zs.length)%zs.length;zshow()}
document.addEventListener('click',e=>{const m=e.target.closest('img[data-zoom]');if(m)return zopen(m);if(e.target.closest('.lbx')||e.target===lb)lb.classList.remove('on');if(e.target.closest('.lbp'))zmove(-1);if(e.target.closest('.lbn'))zmove(1)});
document.addEventListener('keydown',e=>{if(e.target.matches&&e.target.matches('img[data-zoom]')&&e.key==='Enter')return zopen(e.target);if(!lb.classList.contains('on'))return;if(e.key==='Escape')lb.classList.remove('on');if(e.key==='ArrowLeft')zmove(-1);if(e.key==='ArrowRight')zmove(1)});

// forms
document.querySelectorAll('form[data-url]').forEach(f=>f.addEventListener('submit',async e=>{
  e.preventDefault();
  const btn=f.querySelector('button[type=submit]'),msg=f.querySelector('.form-msg'),d=Object.fromEntries(new FormData(f).entries());
  msg.className='form-msg';const bad=[...f.querySelectorAll('[required]')].some(x=>!x.value.trim())||(d.email&&!/^\S+@\S+\.\S+$/.test(d.email));if(bad){msg.className='form-msg err';msg.textContent='Please complete the required fields with a valid email.';return}const o=btn.textContent;btn.disabled=true;btn.textContent='…';
  try{const r=await fetch(f.dataset.url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(d)});const j=await r.json().catch(()=>({}));
    if(r.ok&&j.ok){f.reset();msg.className='form-msg ok';msg.textContent=f.dataset.ok}else{msg.className='form-msg err';msg.textContent=(j&&j.error)||'Your message was not sent. This form is not connected to a destination yet.'}
  }catch(x){msg.className='form-msg err';msg.textContent='Your message was not sent. This form is not connected to a destination yet.'}
  finally{btn.disabled=false;btn.textContent=o}
}));
route();
</script>
