// sound offering (placeholder tone unless Kim uploads a file)
const waveEl=document.getElementById('waveCanvas'),bars=[];
for(let i=0;i<40;i++){const b=document.createElement('i');waveEl.appendChild(b);bars.push(b)}
let audioCtx=null,nodes=null,playing=false,t0=performance.now();
const playIcon=document.getElementById('playIcon'),pauseIcon=document.getElementById('pauseIcon');
(function animate(){const t=(performance.now()-t0)/1000;bars.forEach((b,i)=>{const base=playing?(Math.sin(t*1.6+i*.4)*.5+.5):.12;b.style.height=Math.max(6,8+base*(playing?40:0)+(playing?Math.sin(t*4+i)*4:0))+'px'});requestAnimationFrame(animate)})();
function startTone(){audioCtx=audioCtx||new(window.AudioContext||window.webkitAudioContext)();const m=audioCtx.createGain();m.gain.value=0;m.connect(audioCtx.destination);
  const oscs=[174.6,261.6,392.0].map((f,i)=>{const o=audioCtx.createOscillator();o.type='sine';o.frequency.value=f;const g=audioCtx.createGain();g.gain.value=i===0?.5:.28;o.connect(g);g.connect(m);o.start();return o});
  m.gain.linearRampToValueAtTime(.05,audioCtx.currentTime+1.2);nodes={m,oscs}}
function stopTone(){if(!nodes)return;const{m,oscs}=nodes,n=audioCtx.currentTime;m.gain.cancelScheduledValues(n);m.gain.setValueAtTime(m.gain.value,n);m.gain.linearRampToValueAtTime(0,n+.6);oscs.forEach(o=>o.stop(n+.7));nodes=null}
let heroAudio=new Audio('data:audio/mpeg;base64,');heroAudio.preload='auto';heroAudio.addEventListener('ended',()=>setPlay(false));
function setPlay(on){playing=on;playIcon.hidden=on;pauseIcon.hidden=!on}
